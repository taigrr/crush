# Node A plays the "laptop": it owns a project with uncommitted work and
# an imported conversation, and moves it to node B.
FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOEXPERIMENT=greenteagc go build -o /out/crush .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates jq procps \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/crush /usr/local/bin/crush

# A git project at the same absolute path every node will use, with a
# committed file, an uncommitted edit, an untracked secret, and a
# node_modules tree that must not travel.
RUN git config --global user.email harness@crush.test && git config --global user.name harness \
    && mkdir -p /work/demo && cd /work/demo && git init -q -b main \
    && echo 'package main' > main.go && git add . && git commit -qm init \
    && echo '// uncommitted work' >> main.go \
    && echo 'SECRET=from-node-a' > .env \
    && mkdir -p node_modules/huge && echo x > node_modules/huge/index.js
COPY test/cluster/seed/claude.jsonl /seed/claude.jsonl

# A placeholder provider so commands that need one get far enough to
# exercise cluster rules; it is never actually reached.
COPY test/cluster/seed/crush.json /root/.config/crush/crush.json
# Node A already has provider credentials; node B, freshly installed, has
# none and must receive them from the cluster.
COPY test/cluster/seed/data-crush.json /root/.local/share/crush/crush.json
ENV CRUSH_CLUSTER_ALLOW_DEV=1
EXPOSE 7731 7732
ENTRYPOINT ["crush", "server", "--persistent"]
